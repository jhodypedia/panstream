<section class="max-w-6xl mx-auto px-4 md:px-5 pt-4 md:pt-6">
  <div class="md:flex md:items-end md:justify-between gap-3">
    <div>
      <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">Discover Drama China</h1>
      <p class="text-white/60 mt-1 text-sm md:text-base">Rekomendasi, trending, dan lanjut nonton terakhir.</p>
    </div>

    <div class="mt-4 md:mt-0 flex gap-2">
      <button class="pill" data-genre="1357" data-sort="1">Romance</button>
      <button class="pill" data-genre="1357" data-sort="2">Hot</button>
      <button class="pill" data-genre="1357" data-sort="3">Newest</button>
    </div>
  </div>

  <div id="continueRow" class="mt-5 hidden">
    <h2 class="section-title">Continue Watching</h2>
    <div id="continueList" class="hscroll"></div>
  </div>

  <div class="mt-6">
    <h2 class="section-title">For You</h2>
    <div id="gridForyou" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3"></div>
  </div>

  <div class="mt-7">
    <h2 class="section-title">New Releases</h2>
    <div id="gridNew" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3"></div>
  </div>

  <div class="mt-7 mb-12">
    <div class="flex items-center justify-between">
      <h2 class="section-title">Curated</h2>
      <button id="btnMoreCurated" class="text-sm text-white/70 hover:text-white">Refresh</button>
    </div>
    <div id="gridCurated" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3"></div>
  </div>
</section>
