<section class="max-w-6xl mx-auto px-4 md:px-5 pt-4 md:pt-6">
  <div id="detailShell" class="animate-pulse">
    <div class="h-44 md:h-56 rounded-2xl bg-white/10"></div>
    <div class="mt-4 h-6 w-3/4 bg-white/10 rounded"></div>
    <div class="mt-2 h-4 w-1/2 bg-white/10 rounded"></div>
    <div class="mt-5 h-10 w-40 bg-white/10 rounded-xl"></div>
    <div class="mt-6 h-5 w-48 bg-white/10 rounded"></div>
    <div class="mt-3 grid grid-cols-4 md:grid-cols-10 gap-2">
      <% for (let i=0;i<20;i++){ %>
        <div class="h-10 rounded-xl bg-white/10"></div>
      <% } %>
    </div>
  </div>

  <div id="detailReal" class="hidden">
    <div class="relative overflow-hidden rounded-2xl border border-white/10">
      <img id="detailCover" class="w-full h-48 md:h-64 object-cover opacity-80" />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>

      <div class="absolute bottom-0 left-0 right-0 p-4 md:p-6">
        <div class="flex items-end justify-between gap-3">
          <div>
            <h1 id="detailTitle" class="text-xl md:text-3xl font-extrabold leading-tight"></h1>
            <p id="detailSub" class="text-white/70 text-sm mt-1"></p>
          </div>
          <button id="btnPlayResume" class="btn-primary">▶ Resume</button>
        </div>
      </div>
    </div>

    <div class="mt-5 flex items-center justify-between">
      <h2 class="section-title">Episodes</h2>
      <div class="flex gap-2">
        <button id="epSortAsc" class="pill">Asc</button>
        <button id="epSortDesc" class="pill">Desc</button>
      </div>
    </div>

    <div id="episodeGrid" class="mt-3 grid grid-cols-4 sm:grid-cols-6 md:grid-cols-10 gap-2"></div>

    <div class="mt-8">
      <h2 class="section-title">More Like This</h2>
      <div id="gridMore" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 mt-3"></div>
    </div>

    <div class="h-14"></div>
  </div>
</section>
